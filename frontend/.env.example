# Development (local API)
# VITE_API_URL=http://localhost:4000/api/v1

# Hosted API (Lightsail) — cross-origin from S3/CloudFront SPA.
# Auth tokens are persisted in localStorage because third-party cookies
# are unreliable across CloudFront ↔ API hosts. Prefer same-origin
# CloudFront /api/* proxy with VITE_API_URL=/api/v1 when possible.
VITE_API_URL=https://goldex.retailkerala.com/api/v1
